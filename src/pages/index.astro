---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import Hero from '../components/Hero.astro';
import UseCases from '../components/UseCases.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import DeveloperAPI from '../components/DeveloperAPI.astro';

import Footer from '../components/Footer.astro';
import translations from '../content/translations/en.json';

const currentLang = "en";

// Homepage product entity (§SEO/GEO). SoftwareApplication ties the site's
// primary money page to a structured product record answer engines can cite.
// aggregateRating is sourced from Top.gg — keep it in sync with the real
// rating/count there (never fabricate); update when the Top.gg numbers change.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Subo',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Discord, Web',
	url: 'https://subo.gg/',
	description: SITE_DESCRIPTION,
	publisher: { '@id': 'https://subo.gg/#organization' },
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '4.78',
		ratingCount: '27',
		bestRating: '5',
		worstRating: '1',
	},
};

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} alternates={[
			{lang: 'x-default', href: 'https://subo.gg/'},
			{lang: 'en', href: 'https://subo.gg/'},
			{lang: 'fr', href: 'https://subo.gg/fr/'},
			{lang: 'es', href: 'https://subo.gg/es/'},
			{lang: 'de', href: 'https://subo.gg/de/'},
			{lang: 'pt-BR', href: 'https://subo.gg/pt-br/'},
			{lang: 'it', href: 'https://subo.gg/it/'},
		]} jsonLd={jsonLd} />
	</head>
	<body>
		<Header translations={translations.header} />
		 
		<main>
    		<Hero translations={translations.hero} />
			<Features translations={translations.features} />
			<UseCases translations={translations} />
			<Testimonials translations={translations} />
			<DeveloperAPI translations={translations.developerApi} />
			<CTA translations={translations} />
		</main>
		<Footer translations={translations.footer} currentLang={currentLang} />
	</body>
</html>
