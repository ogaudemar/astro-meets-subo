---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getBlogPosts, postSlug, postUrl } from '../utils/blog';
import translations from '../content/translations/en.json';
import { whatsNewEras, WHATS_NEW_PROLOGUE_ID } from '../data/whats-new';

const t = translations.whatsNew;

// Structure, the anchors and the reasoning behind both: src/data/whats-new.ts.
// Copy: the `whatsNew` key of the translations file. This page holds neither, so
// a locale sibling is `whats-new.astro` with a different translations import and
// a different changelog href — same shape as /changelog and /fr/changelog.
type Entry = { date: Date; title: string; blurb: string; href: string; lead: boolean };
type Era = { id: string; title: string; range?: string; body: string; entries: Entry[] };

const announcements = (await getBlogPosts('en'))
	.filter((post) => (post.data.tags ?? []).includes('announcement'))
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// Oldest first, era by era. Each era runs from its own `from` date up to the
// next era's; the last one is open-ended, so releases announced after this page
// shipped fall into it without anyone editing this file.
const eras: Era[] = whatsNewEras.map((era, i) => {
	const start = new Date(era.from);
	const end = whatsNewEras[i + 1] ? new Date(whatsNewEras[i + 1].from) : null;
	const copy = (t.eras as Record<string, any>)[era.id];

	const entries: Entry[] = announcements
		.filter((post) => post.data.pubDate >= start && (!end || post.data.pubDate < end))
		.map((post) => {
			const slug = postSlug(post);
			return {
				date: post.data.pubDate,
				title: post.data.title,
				// One line per entry is the point of this page. A post with no
				// blurb is a release announced after the page was written: its own
				// description is longer than we'd like but never wrong.
				blurb: (t.entries as Record<string, string>)[slug] ?? post.data.description,
				href: postUrl(post),
				lead: slug === era.lead,
			};
		});

	return { id: era.id, title: copy.title, range: copy.range, body: copy.body, entries };
});

const prologue = (t.eras as Record<string, any>)[WHATS_NEW_PROLOGUE_ID];
const jumpTargets = [
	{ id: WHATS_NEW_PROLOGUE_ID, label: prologue.navLabel },
	...whatsNewEras.map((era) => ({
		id: era.id,
		label: (t.eras as Record<string, any>)[era.id].navLabel,
	})),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={t.pageTitle} description={t.pageDescription} alternates={[
			{lang: 'x-default', href: 'https://subo.gg/whats-new/'},
			{lang: 'en', href: 'https://subo.gg/whats-new/'},
		]} />
	</head>
	<body>
		<Header translations={translations.header} />
		<main>

			<!-- Hero -->
			<section class="wn-hero">
				<div class="container text-center">
					<h1 class="mono">{t.heroTitle}</h1>
					<p class="subtitle">{t.heroSubtitle}</p>
					<nav class="wn-jump" aria-label={t.jumpLabel}>
						<span class="wn-jump__label">{t.jumpLabel}</span>
						{jumpTargets.map((target) => (
							<a href={`#${target.id}`}>{target.label}</a>
						))}
					</nav>
				</div>
			</section>

			<div class="container container--small">

				<!-- Prologue: no post list, because almost nothing before March 2026
				     was announced on this site. It is an entry point, not an era. -->
				<section class="wn-era wn-era--prologue" id={WHATS_NEW_PROLOGUE_ID}>
					<h2>{prologue.title}</h2>
					<p class="wn-era__body">{prologue.body}</p>
					<a class="wn-changelog" href="/changelog/">{t.changelogLink} →</a>
				</section>

				{eras.map((era) => (
					<section class="wn-era" id={era.id}>
						<header class="wn-era__head">
							{era.range && <p class="wn-era__range">{era.range}</p>}
							<h2>{era.title}</h2>
							<p class="wn-era__body">{era.body}</p>
						</header>

						<ol class="wn-list">
							{era.entries.map((entry) => (
								<li class:list={['wn-entry', entry.lead && 'wn-entry--lead']}>
									<div class="wn-entry__date">
										<FormattedDate date={entry.date} />
										{entry.lead && <span class="wn-entry__badge">{t.leadLabel}</span>}
									</div>
									<div class="wn-entry__body">
										<h3><a href={entry.href}>{entry.title}</a></h3>
										<p>{entry.blurb}</p>
										<a class="wn-entry__link" href={entry.href}>{t.readMore} →</a>
									</div>
								</li>
							))}
						</ol>
					</section>
				))}

				<p class="wn-footer-link">
					<a class="wn-changelog" href="/changelog/">{t.changelogLink} →</a>
				</p>
			</div>

			<CTA translations={translations} />
		</main>
		<Footer translations={translations.footer} />
	</body>
</html>

<style>
/* Hero */
.wn-hero {
	padding: 140px 0 48px;
	background:
		radial-gradient(70% 55% at 50% 0%, var(--bg-glow-pink), transparent 70%),
		var(--bg-base);
}
.wn-hero h1 {
	font-family: "IBM Plex Mono", "Source Code Pro", monospace;
	letter-spacing: -0.02em;
	font-size: clamp(2rem, 5vw, 3.5rem);
	font-weight: 800;
	color: var(--accent);
	margin-bottom: 1rem;
}
.wn-hero .subtitle {
	font-size: 1.2rem;
	color: var(--grey-light);
	max-width: 620px;
	margin: 0 auto;
}

/* Jump nav */
.wn-jump {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: center;
	gap: 0.5rem 0.75rem;
	margin-top: 2rem;
}
.wn-jump__label {
	color: var(--grey-light);
	font-size: 0.8rem;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	opacity: 0.7;
}
.wn-jump a {
	display: inline-block;
	padding: 0.35rem 0.85rem;
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 999px;
	color: var(--grey-light);
	font-size: 0.9rem;
	text-decoration: none;
}
.wn-jump a:hover {
	border-color: var(--accent);
	color: var(--accent);
}

/* Eras. scroll-margin keeps the anchored heading clear of the fixed header —
   the whole campaign lands on #since-june and #since-march, so a heading tucked
   under the header would be the first thing 1,000 people see. */
.wn-era {
	padding: 3rem 0 0;
	scroll-margin-top: 90px;
}
.wn-era--prologue {
	padding-top: 2rem;
}
.wn-era__range {
	color: var(--grey-light);
	font-size: 0.8rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	opacity: 0.7;
	margin: 0 0 0.35rem;
}
.wn-era h2 {
	font-family: "IBM Plex Mono", "Source Code Pro", monospace;
	font-size: clamp(1.5rem, 3.5vw, 2rem);
	font-weight: 800;
	margin: 0 0 0.75rem;
}
.wn-era__body {
	color: var(--grey-light);
	line-height: 1.65;
	max-width: 62ch;
	margin: 0 0 0.5rem;
}

/* Entry list */
.wn-list {
	list-style: none;
	margin: 2rem 0 0;
	padding: 0;
	border-left: 2px solid rgba(255, 255, 255, 0.1);
}
.wn-entry {
	position: relative;
	display: grid;
	grid-template-columns: 130px 1fr;
	gap: 1.5rem;
	padding: 0 0 2.5rem 2rem;
}
.wn-entry::before {
	content: "";
	position: absolute;
	left: -7px;
	top: 6px;
	width: 12px;
	height: 12px;
	border-radius: 50%;
	background: var(--accent);
}
.wn-entry:last-child {
	padding-bottom: 0;
}
.wn-entry__date time {
	color: var(--grey-light);
	font-size: 0.9rem;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	white-space: nowrap;
}
.wn-entry__badge {
	display: block;
	margin-top: 0.4rem;
	color: var(--accent);
	font-size: 0.7rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}
.wn-entry--lead .wn-entry__body h3 a {
	color: var(--accent);
}
.wn-entry__body h3 {
	font-size: 1.25rem;
	font-weight: 700;
	margin: 0 0 0.5rem;
	line-height: 1.3;
}
.wn-entry__body h3 a {
	color: var(--white, #fff);
	text-decoration: none;
}
.wn-entry__body h3 a:hover {
	color: var(--accent);
}
.wn-entry__body p {
	color: var(--grey-light);
	line-height: 1.65;
	margin: 0 0 0.75rem;
}
.wn-entry__link {
	color: var(--accent);
	font-size: 0.95rem;
	font-weight: 600;
	text-decoration: none;
}
.wn-entry__link:hover {
	text-decoration: underline;
}

/* Changelog pointer */
.wn-changelog {
	display: inline-block;
	color: var(--grey-light);
	font-size: 0.95rem;
	font-weight: 600;
	text-decoration: none;
}
.wn-changelog:hover {
	color: var(--accent);
	text-decoration: underline;
}
.wn-footer-link {
	margin: 3.5rem 0 1rem;
	padding-top: 2rem;
	border-top: 1px solid rgba(255, 255, 255, 0.1);
}

@media (max-width: 640px) {
	.wn-entry {
		grid-template-columns: 1fr;
		gap: 0.4rem;
	}
	.wn-entry__badge {
		display: inline-block;
		margin: 0 0 0 0.6rem;
	}
}
</style>
