---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getBlogPosts, postUrl, DATE_LOCALE } from '../../../utils/blog';

import translations from '../../../content/translations/fr.json';

const PublishedPosts = await getBlogPosts('fr');

const placeholders = [
	'/images/blog/placeholders/blog-placeholder-2.jpg',
	'/images/blog/placeholders/blog-placeholder-3.jpg',
	'/images/blog/placeholders/blog-placeholder-4.jpg',
	'/images/blog/placeholders/blog-placeholder-5.jpg',
];
function getRandomPlaceholder() {
	return placeholders[Math.floor(Math.random() * placeholders.length)];
}
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={translations.siteTitle} description={translations.siteDescription} alternates={[
			{lang: 'x-default', href: 'https://subo.gg/blog/'},
			{lang: 'en', href: 'https://subo.gg/blog/'},
			{lang: 'fr', href: 'https://subo.gg/fr/blog/'},
		]} />
		<link rel="alternate" type="application/rss+xml" title={translations.siteTitle} href="https://subo.gg/fr/rss.xml" />
		<style>
			body {
				background: linear-gradient(var(--dark), var(--secondary-dark), var(--primary-dark));
				padding: 10rem 0 0 0;
			}

			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 0 10rem 0;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 95%;
					text-align: center;
				}
				ul li .title {
					font-size: 1.1em;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.5em;
				}
				ul li img {
					display: none;
				}
				ul li:first-child img {
					display: block;
				}
			}
		</style>
	</head>
	<body>
		<Header translations={translations.header} />
		<main>
			<section>
				<ul>
					{
						PublishedPosts.map((post) => (
							<li>
								<a href={postUrl(post)}>
									<img
									  width={720}
									  height={360}
									  src={post.data.heroImage ?? getRandomPlaceholder()}
									  alt=""
									/>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} locale={DATE_LOCALE.fr} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer translations={translations.footer}/>
	</body>
</html>
