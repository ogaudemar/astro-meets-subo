---
// The B2B shelf on /pricing: Business / Agency / Enterprise plus the services
// strip. Sits below the consumer tiers so brands that need an invoice or vendor
// onboarding stop landing on a $3 Discord in-app purchase.
//
// Copy lives under `pricingPage.business` in the translations file, in two
// shapes. EN and FR carry the full shelf (`plans` + `services`) because those
// are the languages sales calls happen in. The other locales carry a short
// pointer block instead: same heading, one paragraph, and a single link to the
// English shelf. Deliberately no booking CTA there. A reader who follows a link
// marked "in English" has self-selected into doing business in English, which
// is the only language (besides French) a call can happen in, so the link does
// the qualifying. A locale with no `business` key at all renders nothing.
import { CALENDLY_URL, SALES_EMAIL } from '../consts';

const { business } = Astro.props;
const plans = business?.plans ?? [];
const services = business?.services;
const isPointer = plans.length === 0 && !!business?.moreText;
---

{(plans.length > 0 || isPointer) && (
<section class="b2b" id="for-brands">
  <div class="container">
    <div class="b2b__head">
      <p class="b2b__eyebrow">{business.eyebrow}</p>
      <h2 class="b2b__title">{business.title}</h2>
      <p class="b2b__subtitle">{business.subtitle}</p>
      {business.note && <p class="b2b__note">{business.note}</p>}
      {isPointer && (
        <div class="b2b__pointer-ctas">
          <a
            href={business.moreHref ?? '/pricing/#for-brands'}
            class="button button--accent-bg"
            data-ph-event="pricing_cta_pointer_english"
          >{business.moreText}</a>
        </div>
      )}
    </div>

    <div class="b2b__cards">
      {plans.map((plan) => (
        <div class={`b2b-card b2b-card--${plan.id}`}>
          {plan.badge && <span class="b2b-card__badge">{plan.badge}</span>}
          <h3 class="b2b-card__name">{plan.name}</h3>
          <p class="b2b-card__desc">{plan.description}</p>
          <div class="b2b-card__price">
            <span class="price-main">{plan.price}</span>
            {plan.priceSub && <span class="price-sub">{plan.priceSub}</span>}
          </div>
          <a
            href={CALENDLY_URL}
            class="button button--primary-border b2b-card__cta"
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event={`pricing_cta_${plan.id}_calendly`}
          >{plan.cta}</a>
          {plan.secondaryCtaLabel && (
            <p class="b2b-card__secondary">
              {plan.secondaryCtaLabel}{' '}
              <a href={`mailto:${SALES_EMAIL}`} data-ph-event={`pricing_cta_${plan.id}_email`}>
                {plan.secondaryCtaText ?? SALES_EMAIL}
              </a>
            </p>
          )}
          <div class="b2b-card__feats">
            {business.includesLabel && <p class="b2b-card__feats-label">{business.includesLabel}</p>}
            <ul>
              {plan.features.map((f) => (
                <li>
                  <span class="feat-check" aria-hidden="true">✓</span>
                  <span set:html={f}></span>
                </li>
              ))}
            </ul>
          </div>
          {plan.footnote && <p class="b2b-card__footnote">{plan.footnote}</p>}
        </div>
      ))}
    </div>

    {services && (
      <div class="b2b-services">
        <div class="b2b-services__text">
          <h3 class="b2b-services__title">{services.title}</h3>
          <p class="b2b-services__body">{services.body}</p>
          {services.teamNote && <p class="b2b-services__team" set:html={services.teamNote}></p>}
        </div>
        <a
          href={CALENDLY_URL}
          class="button button--accent-bg"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="pricing_cta_services_calendly"
        >{services.cta}</a>
      </div>
    )}
  </div>
</section>
)}

<script>
  // PostHog autocapture already records these clicks; the named events make the
  // brands funnel legible next to `checkout_intent` without renaming anything.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest?.('[data-ph-event]') as HTMLAnchorElement | null;
    if (!link) return;
    const event = link.getAttribute('data-ph-event');
    if (!event) return;
    const props = { href: link.getAttribute('href'), page: window.location.pathname };
    (window as any).posthog?.capture?.(event, props);
    (window as any).dataLayer?.push?.({ event, ...props });
  });
</script>

<style>
  /* A band, not another row of tier cards: its own background and a rule above
     it so the consumer table visibly ends before this starts. */
  .b2b {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(108, 71, 255, 0.18), transparent 70%),
      transparent;
  }

  .b2b__head {
    max-width: 760px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  /* Pointer locales have no cards under the heading, so the band ends here. */
  .b2b__pointer-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .b2b__eyebrow {
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }
  .b2b__title {
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    letter-spacing: -0.01em;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
    line-height: 1.2;
  }
  .b2b__subtitle {
    font-size: 1.1rem;
    color: #e8e8ea;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .b2b__note {
    font-size: 0.92rem;
    color: var(--grey-light);
    line-height: 1.55;
    margin: 0;
  }

  .b2b__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .b2b-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 3px solid var(--primary);
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
  }
  .b2b-card--business { border-top-color: var(--accent); }
  .b2b-card--enterprise { border-top-color: var(--grey-light); }

  .b2b-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 1.5rem;
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000;
    background: var(--accent);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .b2b-card__name {
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0 0 0.85rem;
  }
  .b2b-card--business .b2b-card__name { color: var(--accent); }
  .b2b-card--agency .b2b-card__name { color: var(--primary); }

  .b2b-card__desc {
    font-size: 0.9rem;
    color: var(--grey-light);
    line-height: 1.5;
    margin: 0 0 1.25rem;
    min-height: 4em; /* keep prices aligned across cards */
  }

  .b2b-card__price {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 3.2rem; /* room for the yearly sub-line so the CTAs line up */
    margin-bottom: 1.5rem;
  }
  .price-main {
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
  }
  .price-sub {
    font-size: 0.85rem;
    color: var(--grey-light);
    margin-top: 0.25rem;
  }

  .b2b-card__cta {
    box-sizing: border-box;
    width: 100%;
    text-align: center;
  }

  .b2b-card__secondary {
    font-size: 0.82rem;
    color: var(--grey-light);
    text-align: center;
    margin: 0.75rem 0 0;
  }
  .b2b-card__secondary a {
    color: #fff;
  }

  .b2b-card__feats {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .b2b-card__feats-label {
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-light);
    margin: 0 0 0.9rem;
  }
  .b2b-card__feats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .b2b-card__feats li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.88rem;
    color: #e8e8ea;
    line-height: 1.4;
  }
  .feat-check {
    color: var(--accent);
    font-weight: 700;
    flex: 0 0 auto;
  }

  .b2b-card__footnote {
    font-size: 0.78rem;
    color: var(--grey-light);
    line-height: 1.45;
    margin: 1.25rem 0 0;
  }

  .b2b-services {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
  }
  .b2b-services__title {
    font-family: "IBM Plex Mono", "Source Code Pro", monospace;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .b2b-services__body {
    font-size: 0.95rem;
    color: #e8e8ea;
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }
  .b2b-services__team {
    font-size: 0.85rem;
    color: var(--grey-light);
    line-height: 1.55;
    margin: 0.85rem 0 0;
    max-width: 62ch;
  }
  .b2b-services__team :global(a) {
    color: var(--accent);
  }
  .b2b-services .button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  @media (max-width: 968px) {
    .b2b__cards {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin: 0 auto;
    }
    .b2b-card__desc {
      min-height: 0;
    }
    .b2b-services {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .b2b-services .button {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .b2b {
      padding: 3rem 0 3.5rem;
    }
    .b2b__title {
      font-size: 1.6rem;
    }
  }
</style>
