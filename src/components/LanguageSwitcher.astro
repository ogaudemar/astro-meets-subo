---
/**
 * Language switcher.
 *
 * Renders REAL <a href> links, resolved at build time. It used to be a <select>
 * whose only navigation was `window.location.pathname = …` in a click handler,
 * which meant the localized tree had no crawlable inbound links at all: an audit
 * on 2026-08-25 found that ZERO of 98 English pages linked to any /fr/ page, and
 * Search Console reported "Referring page: None detected" for /fr/polls/ while
 * that page sat in "Crawled - currently not indexed".
 *
 * Two rules this file now keeps:
 *
 * 1. Links are anchors, so Google can follow them and pass equity between
 *    locales instead of treating each language as an island.
 * 2. Hrefs carry the trailing slash, matching the canonical. Internal links
 *    elsewhere on the site still omit it (119 URLs, ~7,900 instances) and
 *    Google is not crediting those to the canonical URL. Don't add more.
 *
 * Targets are checked against the real route list rather than guessed. Astro's
 * `import.meta.glob` enumerates the page files at build time, so a locale that
 * genuinely lacks a page links to that locale's homepage instead of 404-ing,
 * which is what the old handler did on every blog post (slugs differ per
 * language by design).
 */

const { currentLang = "en", availableLangs = [
  { code: "en", label: "English" },
  { code: "fr", label: "Français" },
  { code: "es", label: "Español" },
  { code: "de", label: "Deutsch" },
  { code: "pt-br", label: "Português" },
  { code: "it", label: "Italiano" }
] } = Astro.props;

const LOCALES = ["fr", "es", "de", "pt-br", "it"];

// Every static page route in the project, as a set of canonical paths.
// Dynamic routes ([...slug], [redirect]) are skipped: their params are not
// knowable here, and a blog post has no same-slug twin in another language
// anyway, so those correctly fall through to the locale homepage.
const routes = new Set(
  Object.keys(import.meta.glob("/src/pages/**/*.astro"))
    .map((file) =>
      file
        .replace("/src/pages", "")
        .replace(/\.astro$/, "")
        .replace(/\/index$/, "")
    )
    .filter((route) => !route.includes("["))
    .map((route) => (route === "" ? "/" : `${route}/`))
);

/** Locale-stripped path: "/fr/use-cases/research/" -> "use-cases/research" */
const segments = Astro.url.pathname.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean);
const basePath = LOCALES.includes(segments[0]) ? segments.slice(1).join("/") : segments.join("/");

/** Canonical path for `basePath` in `lang`, with the trailing slash. */
function pathFor(lang: string, path: string) {
  const prefix = lang === "en" ? "" : `/${lang}`;
  return path ? `${prefix}/${path}/` : `${prefix}/`;
}

const links = availableLangs.map((lang: { code: string; label: string }) => {
  const wanted = pathFor(lang.code, basePath);
  // Fall back to the locale homepage when this page has no counterpart there.
  const href = routes.has(wanted) ? wanted : pathFor(lang.code, "");
  return { ...lang, href, isFallback: href !== wanted };
});

const current = links.find((l) => l.code === currentLang) ?? links[0];
---

<div class="language-switcher">
  <span class="language-switcher-label">🌐</span>
  <div class="custom-select" id="custom-lang-select">
    <button
      type="button"
      class="custom-select-selected"
      aria-haspopup="true"
      aria-expanded="false"
    >{current.label}</button>
    <div class="custom-select-options">
      {links.map((lang) => (
        <a
          class:list={["custom-select-option", { selected: lang.code === currentLang }]}
          href={lang.href}
          hreflang={lang.code}
          data-lang={lang.code}
        >{lang.label}</a>
      ))}
    </div>
  </div>
</div>

<script>
(function() {
  const customSelect = document.getElementById('custom-lang-select');
  if (!customSelect) return;
  const selected = customSelect.querySelector('.custom-select-selected') as HTMLButtonElement | null;
  const optionsDiv = customSelect.querySelector('.custom-select-options') as HTMLElement | null;
  if (!selected || !optionsDiv) return;

  function close() {
    optionsDiv!.style.display = 'none';
    customSelect!.classList.remove('open');
    selected!.setAttribute('aria-expanded', 'false');
  }
  function open() {
    optionsDiv!.style.display = 'block';
    customSelect!.classList.add('open');
    selected!.setAttribute('aria-expanded', 'true');
  }

  selected.addEventListener('click', (e) => {
    e.stopPropagation();
    customSelect.classList.contains('open') ? close() : open();
  });
  document.addEventListener('click', close);

  // Remember the choice, then let the anchor navigate on its own. The
  // preference is what BaseHead's redirect script reads on / and /pricing.
  optionsDiv.querySelectorAll<HTMLAnchorElement>('.custom-select-option').forEach((option) => {
    option.addEventListener('click', () => {
      const lang = option.dataset.lang;
      if (lang) {
        try { localStorage.setItem('preferredLang', lang); } catch (err) { /* private mode */ }
      }
    });
  });
})();
</script>

<style>
.custom-select {
  position: relative;
  display: inline-block;
  min-width: 120px;
  font-family: inherit;
}
.custom-select-selected {
  background: rgba(30,30,30,0.8);
  color: #fff;
  padding: 0.6em 1.2em;
  border-radius: 0.8em;
  font-size: 1em;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: background 0.2s, border 0.2s;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  font-family: inherit;
  text-align: left;
}
.custom-select-selected::after {
  content: '';
  display: inline-block;
  margin-left: 0.7em;
  width: 0.7em;
  height: 0.7em;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(135deg);
  transition: transform 0.2s;
}
.custom-select.open .custom-select-selected {
  background: rgba(30,30,30,0.95);
  border: 1px solid var(--accent, #ffb347);
}
.custom-select.open .custom-select-selected::after {
  transform: rotate(-45deg); /* Arrow points up */
}
.custom-select-options {
  display: none;
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(100% + 4px);
  top: auto;
  background: rgba(30,30,30,0.97);
  border-radius: 0.8em;
  box-shadow: 0 4px 16px rgba(0,0,0,0.18);
  z-index: 10;
  font-size: 1em;
  overflow: hidden;
  padding: 0.4em 0;
}
.custom-select-option {
  display: block;
  padding: 0.5em 1.2em;
  color: #fff;
  text-decoration: none;
  cursor: pointer;
}
.custom-select-option:hover {
  background: rgba(255,255,255,0.08);
  color: var(--accent, #ffb347);
}
.custom-select-option.selected {
  font-weight: 700;
  color: var(--accent, #ffb347);
}
</style>
